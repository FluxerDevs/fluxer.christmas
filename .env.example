# Copy to .env for local development (`pnpm dev` reads it).

# Public URL of the site; must match a redirect URI registered with Fluxer (+ /callback).
ORIGIN=http://localhost:4321
FLUXER_CLIENT_ID=1555762697700651008
FLUXER_CLIENT_SECRET=
# Fluxer instance whose /.well-known/fluxer lists the web app, API and media hosts.
FLUXER_INSTANCE=https://canary.fluxer.com
# Work-in-progress gate: only whitelisted, logged-in users get in (comma-separated user IDs).
REQUIRE_LOGIN=false
FLUXER_WHITELIST=
# Signs invite join tickets. Required in production; random per run in development.
SESSION_SECRET=
# Where the SQLite database lives.
DATA_DIR=data
